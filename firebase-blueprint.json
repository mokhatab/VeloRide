        "bodyEn": { "type": "string" },
        "rideId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "channel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventType", "idempotencyKey", "titleAr", "titleEn", "bodyAr", "bodyEn", "rideId", "isRead", "channel", "createdAt", "updatedAt"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Immutable post-trip rating and review.",
      "type": "object",
      "properties": {
        "rideId": { "type": "string" },
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "fromRole": { "type": "string", "enum": ["RIDER", "DRIVER"] },
        "stars": { "type": "integer" },
        "comment": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raterName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rideId", "fromUserId", "toUserId", "fromRole", "stars", "comment", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit log for pricing, driver approval, and operational changes.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetCollection": { "type": "string" },
        "targetId": { "type": "string" },
        "previousValueSummary": { "type": "string" },
        "newValueSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorEmail", "action", "targetCollection", "targetId", "previousValueSummary", "newValueSummary", "createdAt"]
    },
    "OperationalConfig": {
      "title": "OperationalConfig",
      "description": "Platform dispatch radius, offer duration, cancellation, and commission settings.",
      "type": "object",
      "properties": {
        "dispatchRound1RadiusKm": { "type": "number" },
        "dispatchRound2RadiusKm": { "type": "number" },
        "dispatchRound3RadiusKm": { "type": "number" },
        "offerDurationSeconds": { "type": "integer" },
        "gpsFreshnessMaxSeconds": { "type": "integer" },
        "cancellationFreeWindowSeconds": { "type": "integer" },
        "cancellationFeeMinor": { "type": "integer" },
        "platformCommissionPercent": { "type": "number" },
        "updatedByAdminId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dispatchRound1RadiusKm", "dispatchRound2RadiusKm", "dispatchRound3RadiusKm", "offerDurationSeconds", "gpsFreshnessMaxSeconds", "cancellationFreeWindowSeconds", "cancellationFeeMinor", "platformCommissionPercent", "updatedByAdminId", "createdAt", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authoritative RBAC administrator registry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Rider or driver support complaint for administrative review.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "rideId": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "UNDER_REVIEW", "RESOLVED"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rideId", "category", "description", "status", "adminNotes", "createdAt", "updatedAt"]
    }
  },
